alt - f18 : osascript -e 'display notification "Alt+F18" with title "SwiftKHD"'
alt - f19 : osascript -e 'display notification "Alt+F19" with title "SwiftKHD"'

# ── Cmd ───────────────────────────────────────────────────────────────────────
cmd - f1  : osascript -e 'display notification "Cmd+F1"  with title "SwiftKHD"' # ! conflicts: Mirror Displays
cmd - f2  : osascript -e 'display notification "Cmd+F2"  with title "SwiftKHD"'
