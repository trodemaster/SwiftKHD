# Function key test config — all modifier combinations up to 3 keys
# Run with: swiftkhd -c fntest.skhdrc
# Modifiers: alt (Option), cmd (Command), ctrl (Control), shift (Shift)
#
# Lines marked "! conflicts:" may be intercepted by macOS before SwiftKHD sees them,
# or may fire alongside the system action if SwiftKHD wins the race.

# ── Bare ─────────────────────────────────────────────────────────────────────
f1  : osascript -e 'display notification "F1"  with title "SwiftKHD"'
f2  : osascript -e 'display notification "F2"  with title "SwiftKHD"'
f3  : osascript -e 'display notification "F3"  with title "SwiftKHD"' # ! conflicts: Mission Control
f4  : osascript -e 'display notification "F4"  with title "SwiftKHD"' # ! conflicts: Launchpad (Apple keyboards)
f5  : osascript -e 'display notification "F5"  with title "SwiftKHD"'
f6  : osascript -e 'display notification "F6"  with title "SwiftKHD"'
f7  : osascript -e 'display notification "F7"  with title "SwiftKHD"'
f8  : osascript -e 'display notification "F8"  with title "SwiftKHD"'
f9  : osascript -e 'display notification "F9"  with title "SwiftKHD"'
f10 : osascript -e 'display notification "F10" with title "SwiftKHD"'
f11 : osascript -e 'display notification "F11" with title "SwiftKHD"' # ! conflicts: Show Desktop
f12 : osascript -e 'display notification "F12" with title "SwiftKHD"'
f13 : osascript -e 'display notification "F13" with title "SwiftKHD"' # ! conflicts: Print Screen / Screenshot (some keyboards)
f14 : osascript -e 'display notification "F14" with title "SwiftKHD"'
f15 : osascript -e 'display notification "F15" with title "SwiftKHD"'
f16 : osascript -e 'display notification "F16" with title "SwiftKHD"'
f17 : osascript -e 'display notification "F17" with title "SwiftKHD"'
f18 : osascript -e 'display notification "F18" with title "SwiftKHD"'
f19 : osascript -e 'display notification "F19" with title "SwiftKHD"'

# ── Alt ───────────────────────────────────────────────────────────────────────
