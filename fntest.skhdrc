# ── Ctrl ──────────────────────────────────────────────────────────────────────
# Ctrl+F2-F8 conflict with Full Keyboard Access shortcuts (System Settings > Keyboard > Keyboard Shortcuts > Keyboard)
ctrl - f1  : osascript -e 'display notification "Ctrl+F1"  with title "SwiftKHD"'
ctrl - f2  : osascript -e 'display notification "Ctrl+F2"  with title "SwiftKHD"' # ! conflicts: Move focus to menu bar
ctrl - f3  : osascript -e 'display notification "Ctrl+F3"  with title "SwiftKHD"' # ! conflicts: Move focus to Dock
ctrl - f4  : osascript -e 'display notification "Ctrl+F4"  with title "SwiftKHD"' # ! conflicts: Move focus to active/next window
ctrl - f5  : osascript -e 'display notification "Ctrl+F5"  with title "SwiftKHD"' # ! conflicts: Move focus to window toolbar
ctrl - f6  : osascript -e 'display notification "Ctrl+F6"  with title "SwiftKHD"' # ! conflicts: Move focus to floating window
ctrl - f7  : osascript -e 'display notification "Ctrl+F7"  with title "SwiftKHD"' # ! conflicts: Toggle Tab focus mode
ctrl - f8  : osascript -e 'display notification "Ctrl+F8"  with title "SwiftKHD"' # ! conflicts: Move focus to status menus
ctrl - f9  : osascript -e 'display notification "Ctrl+F9"  with title "SwiftKHD"'
ctrl - f10 : osascript -e 'display notification "Ctrl+F10" with title "SwiftKHD"'
ctrl - f11 : osascript -e 'display notification "Ctrl+F11" with title "SwiftKHD"'
ctrl - f12 : osascript -e 'display notification "Ctrl+F12" with title "SwiftKHD"'
ctrl - f13 : osascript -e 'display notification "Ctrl+F13" with title "SwiftKHD"'
ctrl - f14 : osascript -e 'display notification "Ctrl+F14" with title "SwiftKHD"'
